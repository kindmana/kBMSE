{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kBMSE",
  "version": "0.4.0",
  "identifier": "com.kindmana.kbmse",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kBMSE",
        "width": 1280,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["bms", "bme", "bml", "pms"],
        "name": "BMS File",
        "description": "Be-Music Source Pattern File",
        "role": "Editor"
      }
    ]
  }
}
